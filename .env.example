# Safe sample values only. Never put credentials or private keys here.
LEDGERLOCK_ENV=development
LEDGERLOCK_API_MODE=mock
LEDGERLOCK_LOG_LEVEL=INFO
LEDGERLOCK_CHECKPOINT_SECRET=
LEDGERLOCK_ADMIN_TOKEN=

# Cloud adapters remain disabled unless an authorised GCP or local Floci lab is configured.
APP_ENV=local-simulation
USE_CLOUD_SERVICES=false
GCP_PROJECT_ID=floci-local
GCP_REGION=us-central1
FIRESTORE_COLLECTION=audit_ledger_floci
KMS_KEY_RING=ledgerlock-keyring
KMS_KEY_NAME=checkpoint-signer
KMS_KEY_VERSION=1
CLOUD_RUN_SERVICE=ledgerlock-api
CLOUD_LOG_NAME=ledgerlock-audit-events

# Architecture references used by the existing documentation.
GOOGLE_CLOUD_PROJECT=replace-with-assigned-project-id
FIRESTORE_DATABASE=(default)
KMS_KEY_RESOURCE=projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/KEY

# Local Floci-GCP only. Do not set this for real Google Cloud.
FLOCI_GCP_ENDPOINT=http://localhost:4588
FIRESTORE_EMULATOR_HOST=localhost:4588
RUN_FLOCI_INTEGRATION=false
FLOCI_ENDPOINT=http://localhost:4588
SERVICE_ACCOUNT_NAME=ledgerlock-sa
