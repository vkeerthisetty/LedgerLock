        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    USER[\&quot;User / Browser / Test Client\&quot;]\n\n    subgraph CURRENT[\&quot;CURRENT IMPLEMENTATION - LOCAL\&quot;]\n        direction TB\n        UI[\&quot;LedgerLock Dashboard\&quot;]\n        MOCK[\&quot;Browser Mock Mode - Synthetic Preview\&quot;]\n        API[\&quot;FastAPI Backend\&quot;]\n        ROUTES[\&quot;Implemented API Routes&lt;br/&gt;POST /api/events&lt;br/&gt;GET /api/ledger&lt;br/&gt;POST /api/verify&lt;br/&gt;POST /api/checkpoints\&quot;]\n        MEM[\&quot;In-Memory AuditLedger\&quot;]\n        SHA[\&quot;Server-generated Sequence&lt;br/&gt;Canonical Record + SHA-256\&quot;]\n        HMAC[\&quot;Local HMAC-SHA256 Checkpoint\&quot;]\n        VERIFY[\&quot;Hash Chain Verification\&quot;]\n        PYLOG[\&quot;Local Sanitized Python Logging\&quot;]\n\n        UI --&gt; MOCK\n        UI --&gt; API\n        API --&gt; ROUTES\n        ROUTES --&gt; MEM\n        MEM --&gt; SHA\n        ROUTES --&gt; HMAC\n        ROUTES --&gt; VERIFY\n        API --&gt; PYLOG\n    end\n\n    subgraph TARGET[\&quot;TARGET CLOUD ARCHITECTURE - NOT YET VERIFIED\&quot;]\n        direction TB\n        BAPI[\&quot;FastAPI API\&quot;]\n        VALIDATE[\&quot;Request Validation\&quot;]\n        AUTH[\&quot;Authentication and Authorization\&quot;]\n        CANON[\&quot;Canonical Record Creation\&quot;]\n        SEQ[\&quot;API Generates Authoritative Sequence\&quot;]\n        HASH[\&quot;Previous Hash + SHA-256\&quot;]\n        FS[\&quot;Firestore - Durable Ledger Storage\&quot;]\n        CP[\&quot;Checkpoint Metadata\&quot;]\n        SIGN[\&quot;Cloud KMS - Non-exportable Private Key\&quot;]\n        PUB[\&quot;Public Key Signature Verification\&quot;]\n        CHAIN[\&quot;Ledger Chain Verification\&quot;]\n        RESULT[\&quot;Verification Result\&quot;]\n        CLOUDFLOG[\&quot;Cloud Logging - Sanitized Security Events\&quot;]\n\n        BAPI --&gt; VALIDATE\n        VALIDATE --&gt; AUTH\n        AUTH --&gt; CANON\n        CANON --&gt; SEQ\n        SEQ --&gt; HASH\n        HASH --&gt; FS\n        FS --&gt; CP\n        CP --&gt; SIGN\n        FS --&gt; CHAIN\n        CP --&gt; PUB\n        SIGN --&gt; PUB\n        CHAIN --&gt; RESULT\n        PUB --&gt; RESULT\n        BAPI -.-&gt; CLOUDFLOG\n        SIGN -.-&gt; CLOUDFLOG\n    end\n\n    subgraph DEPLOY[\&quot;DEPLOYMENT AND VERIFICATION CONTEXTS\&quot;]\n        LOCAL[\&quot;Local Development\&quot;]\n        RENDER[\&quot;Render - Deployment Configuration Present&lt;br/&gt;Actual Revision and Health Evidence Required\&quot;]\n        CLOUDRUN[\&quot;Cloud Run - Target Deployment&lt;br/&gt;Configuration Present / Unverified\&quot;]\n        FLOCI[\&quot;Floci - Separate Verification Context\&quot;]\n    end\n\n    USER --&gt; UI\n    USER --&gt; BAPI\n\n    LOCAL -.-&gt; CURRENT\n    RENDER -.-&gt; CURRENT\n    CLOUDRUN -.-&gt; TARGET\n    FLOCI -.-&gt; CURRENT\n\n    NOTE[\&quot;Security Requirements:&lt;br/&gt;Browser never accesses Firestore or KMS directly.&lt;br/&gt;Only synthetic records are permitted.&lt;br/&gt;Local HMAC is NOT Cloud KMS evidence.&lt;br/&gt;Cloud KMS private keys must not be exported.\&quot;]\n\n    TARGET -.-&gt; NOTE\n\n    classDef implemented fill:#dbeafe,stroke:#2563eb,color:#1e3a8a\n    classDef partial fill:#fef3c7,stroke:#d97706,color:#78350f\n    classDef planned fill:#fce7f3,stroke:#db2777,color:#831843\n    classDef environment fill:#ede9fe,stroke:#7c3aed,color:#4c1d95\n    classDef note fill:#f3f4f6,stroke:#6b7280,color:#111827\n\n    class UI,MOCK,API,ROUTES,MEM,SHA,HMAC,VERIFY,PYLOG implemented\n    class RENDER,CLOUDRUN partial\n    class BAPI,VALIDATE,AUTH,CANON,SEQ,HASH,FS,CP,SIGN,PUB,CHAIN,RESULT,CLOUDFLOG planned\n    class LOCAL,FLOCI environment\n    class NOTE note\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hO7TPFO9uI0lFCBz5lG9-44">
